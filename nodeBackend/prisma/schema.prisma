generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cart {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model cart_items {
  id                 BigInt    @id @default(autoincrement())
  product_id         BigInt
  product_variant_id BigInt
  quantity           Int       @default(1)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
}

model categories {
  id          BigInt    @id @default(autoincrement())
  title       String    @unique @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model order_items {
  id                 BigInt    @id @default(autoincrement())
  product_id         BigInt
  product_variant_id BigInt
  quantity           Int       @default(1)
  rate               Decimal   @default(0) @db.Decimal(10, 2)
  order_id           BigInt
  cart_item_id       BigInt
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
}

model orders {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt
  cart_id       BigInt
  amount        Decimal   @default(0) @db.Decimal(10, 2)
  order_status  String    @default("pending") @db.VarChar(20)
  remarks       String?
  cancel_reason String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model payments {
  id             BigInt    @id @default(autoincrement())
  user_id        BigInt
  order_id       BigInt
  payment_method String    @db.VarChar(100)
  amount         Decimal   @default(0) @db.Decimal(10, 2)
  transaction_id String?   @db.VarChar(100)
  payment_status String    @default("pending") @db.VarChar(20)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
}

model product_categories {
  id          BigInt    @id @default(autoincrement())
  product_id  BigInt
  category_id BigInt
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model product_reviews {
  id                 BigInt    @id @default(autoincrement())
  user_id            BigInt
  product_id         BigInt
  product_variant_id BigInt
  review_title       String    @db.VarChar(255)
  description        String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
}

model product_variants {
  id            BigInt    @id @default(autoincrement())
  variant_name  String    @db.VarChar(255)
  variant_type  String    @db.VarChar(20)
  variant_value String    @db.VarChar(20)
  description   String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([variant_name], map: "idx_variant_name_product_variants")
}

model products {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model users {
  id               BigInt    @id @default(autoincrement())
  name             String    @db.VarChar(255)
  email            String    @unique @db.VarChar(200)
  phone            String?   @db.VarChar(20)
  address          String?   @db.VarChar(255)
  billing_address  String?   @db.VarChar(255)
  shipping_address String?   @db.VarChar(255)
  username         String    @unique @db.VarChar(100)
  password         String    @db.VarChar(255)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
}
